# ==============================================================================
# 8 VIETNAMESE TRAFFIC SIGNS (Unique recognitionColors encode class_id 0..7)
# ==============================================================================
# Leg A (S8 Eastbound, right curb y=-4.8, facing -X -> rot 0)
VietnamTrafficSign {
  translation -26 -4.8 0
  rotation 0 0 1 0
  name "sign_speed_50_a"
  signClass "speed_limit_50"
  textureUrl [ "../textures/signs/speed_limit_50.png" ]
  recognitionColors [ 0.0 1.0 0.5 ]
}
VietnamTrafficSign {
  translation -9.5 -5.3 0
  rotation 0 0 1 0
  name "sign_turn_left_a"
  signClass "turn_left"
  textureUrl [ "../textures/signs/turn_left.png" ]
  recognitionColors [ 0.0 0.4 1.0 ]
}

# Leg B (NE Loop Clockwise: S1 North -> S2 East -> S3 South -> S4 West)
VietnamTrafficSign {
  translation 4.8 24 0
  rotation 0 0 1 1.5707963
  name "sign_speed_30_b"
  signClass "speed_limit_30"
  textureUrl [ "../textures/signs/speed_limit_30.png" ]
  recognitionColors [ 1.0 0.85 0.0 ]
}
VietnamTrafficSign {
  translation 30 55.2 0
  rotation 0 0 1 0
  name "sign_no_right_b"
  signClass "no_right_turn"
  textureUrl [ "../textures/signs/no_right_turn.png" ]
  recognitionColors [ 1.0 0.35 0.0 ]
}
VietnamTrafficSign {
  translation 24 4.8 0
  rotation 0 0 1 3.1415926
  name "sign_stop_b"
  signClass "stop"
  textureUrl [ "../textures/signs/stop.png" ]
  recognitionColors [ 1.0 0.0 0.0 ]
}
VietnamTrafficSign {
  translation 11 4.8 0
  rotation 0 0 1 3.1415926
  name "sign_go_straight_b"
  signClass "go_straight"
  textureUrl [ "../textures/signs/go_straight.png" ]
  recognitionColors [ 0.0 0.9 1.0 ]
}

# Leg C (SW Loop Counter-Clockwise: S8 West -> S7 South -> S6 East -> S5 North)
VietnamTrafficSign {
  translation -64.8 -30 0
  rotation 0 0 1 -1.5707963
  name "sign_no_left_c"
  signClass "no_left_turn"
  textureUrl [ "../textures/signs/no_left_turn.png" ]
