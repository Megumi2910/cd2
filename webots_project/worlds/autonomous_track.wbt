Pine { translation -72 -45 0 name "pine_4" }

# ==============================================================================
# AUTONOMOUS 4-WHEEL ACKERMANN ROBOT (BMW X5 + 640x480 Camera + GPS + Compass)
# ==============================================================================
BmwX5 {
  translation -36 -2 0.4
  rotation 0 0 1 0
  name "autonomous_robot"
  controller "autonomous_driver"
  sensorsSlotTop [
    Camera {
      translation 1.85 0 -0.10
      rotation 0 1 0 0.14
      name "camera"
      fieldOfView 1.05
      width 640
      height 480
      recognition Recognition {
        maxRange 55
        maxObjects 12
        occlusion 1
      }
    }
  ]
  sensorsSlotCenter [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
    Gyro {
      name "gyro"
    }
  ]
}
