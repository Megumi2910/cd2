EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "../protos/VietnamTrafficSign.proto"

WorldInfo {
  info [
    "Nanana Group - AI Traffic Sign Recognition & Lane Keeping Simulation"
    "Dual-loop figure-8 test track with central 4-way intersection and 8 Vietnamese traffic signs."
  ]
  title "Nanana Autonomous Robot Track"
  ERP 0.6
  basicTimeStep 16
  lineScale 1
  contactProperties [
    ContactProperties {
      coulombFriction [ 8 ]
      softCFM 1e-05
      bumpSound ""
      rollSound ""
      slideSound ""
    }
  ]
}

Viewpoint {
  orientation -0.18 0.25 0.95 1.15
  position -46 -12 9
  near 1
  follow "autonomous_robot"
  followSmoothness 0.05
}

TexturedBackground {
  texture "noon_cloudy_countryside"
}

TexturedBackgroundLight {
  texture "noon_cloudy_countryside"
}

DEF GROUND Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.42 0.56 0.34
        roughness 0.9
        metalness 0
      }
      geometry DEF GROUND_PLANE Plane {
        size 500 500
      }
    }
  ]
  boundingObject USE GROUND_PLANE
  locked TRUE
}

# ==============================================================================
# CENTRAL 4-WAY INTERSECTION AT (0, 0)
# roadsWidth = 8.0, startRoadsLength = 4.0 -> 4 exits at (±8, 0) and (0, ±8)
# ==============================================================================
RoadIntersection {
  translation 0 0 0.005
  rotation 0 0 1 0.78539816
  name "central_intersection"
  id "center"
  roadsWidth 8
  startRoadsLength [ 4 ]
  startRoadsNumberOfLanes 2
  startRoadsLine [
    RoadLine {
      color 0.95 0.82 0.12
      type "continuous"
    }
  ]
  startRoadBorder FALSE
}

